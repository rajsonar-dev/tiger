def tower(n, source, destination, helper):
    
    if n == 1:
        print("Move disk 1 from", source, "to", destination)
        return

    tower(n - 1, source, helper, destination)

    print("Move disk", n, "from", source, "to", destination)

    tower(n - 1, helper, destination, source)
tower(3, 'A', 'C', 'B')